# Required database credentials used by setup.sh
PG_PASS=replace-with-strong-postgresql-password
MONGO_PASS=replace-with-strong-mongodb-password
MYSQL_PASS=replace-with-strong-mysql-password
REDIS_PASS=replace-with-strong-redis-password
CASS_PASS=replace-with-strong-cassandra-password

MINIO_ROOT_USER=replace-with-minio-root-user
MINIO_ROOT_PASSWORD=replace-with-strong-minio-root-password

# Optional deployment overrides
# KUBECONFIG=/path/to/kubeconfig
# VALUES_FILE=./db-cluster/values.yaml
# LONGHORN_REPLICA_COUNT=1
# MINIO_RELEASE=my-minio
# MINIO_VALUES_FILE=./minio/values.vault.yaml

# Optional public web service access. Leave unset to be prompted by setup.sh.
# SERVICE_HTTPS_ENABLED=true
# LONGHORN_INGRESS_ENABLED=true
# LONGHORN_PUBLIC_DOMAIN=longhorn.autonomous-istad.com
# VAULT_PUBLIC_DOMAIN=vault.autonomous-istad.com
# MINIO_PUBLIC_DOMAIN=minio.autonomous-istad.com

# Optional shared operator namespaces
# EXTERNAL_SECRETS_NAMESPACE=external-secrets
# CNPG_NAMESPACE=cnpg-system
# PSMDB_NAMESPACE=database-operators
# PXC_NAMESPACE=database-operators
# REDIS_NAMESPACE=database-operators
# K8SSANDRA_NAMESPACE=database-operators
# CERT_MANAGER_NAMESPACE=cert-manager
